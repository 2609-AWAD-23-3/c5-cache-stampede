# Giá trị mặc định (xem CONTRACT.md mục 5). [calibrate] = hiệu chỉnh trong pilot rồi đóng băng.
CACHE_TTL_MS=3000
PG_POOL_MAX=10
SEED_REVIEWS=800000
LOCK_LEASE_MS=5000
WAIT_POLL_MS=5
WAIT_TIMEOUT_MS=2000

# Giới hạn CPU container [calibrate]
APP_CPUS=1
PG_CPUS=2
REDIS_CPUS=1
BENCH_CPUS=1

# Runner
PAIRS=10
BURST_SIZE=200
RESULTS_KIND=pilot
ORDER_SEED=20261117

# Docker Compose tự đọc file `.env`: `cp .env.example .env` trước khi chạy.
